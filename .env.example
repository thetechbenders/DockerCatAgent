# Copy to .env; do not put secrets or personal account credentials here.
CLAUDE_CHANNEL=stable
CONTAINER_MEMORY_LIMIT=4g
CONTAINER_CPUS=2
CONTAINER_PIDS_LIMIT=512

# Optional SSH
SSH_BIND_ADDRESS=127.0.0.1
SSH_PORT=2222
OAUTH_CALLBACK_PORT=8765
# SSH_AUTHORIZED_KEYS_FILE=/absolute/path/to/authorized_keys

# Optional Obsidian
# OBSIDIAN_VAULT_PATH=/absolute/path/to/existing/vault
